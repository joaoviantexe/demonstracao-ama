# Variáveis de ambiente da AMA (docs/ARQUITETURA.md §3).
# Copie para .env (que NÃO vai para o git) e preencha. Na Vercel, cadastre em
# Settings > Environment Variables. Deixe vazio o que ainda não for usar:
# o site funciona sem Supabase (conteúdo padrão) e a loja mostra "em configuração".

# --- Supabase (Settings > API Keys do projeto) ---
# URL do projeto, ex.: https://abcdefgh.supabase.co  (alternativa: NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL=
# Chave pública (publishable "sb_publishable_..." ou a antiga "anon"). Pode ir ao navegador.
# Uma chave secreta posta aqui por engano é ignorada (o site fica como "não configurado" e loga o erro).
# Alternativas aceitas: SUPABASE_PUBLISHABLE_KEY, NEXT_PUBLIC_SUPABASE_ANON_KEY, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SUPABASE_ANON_KEY=
# Chave secreta ("sb_secret_..." ou a antiga "service_role"). SÓ no servidor; ignora a RLS.
# Alternativa aceita: SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# URL pública, ex.: https://www.ama.org.br (usada nos links de pagamento, webhooks e e-mails).
# Sem "https://" ele é acrescentado; caminho e barra final são descartados; valor inválido é ignorado.
# Vazio: usa https://VERCEL_PROJECT_PRODUCTION_URL e depois o host da requisição.
SITE_URL=

# --- Mercado Pago (Suas integrações > Credenciais) ---
# Access Token (de teste ou de produção).
MP_ACCESS_TOKEN=
# Assinatura secreta dos Webhooks (Suas integrações > Webhooks).
MP_WEBHOOK_SECRET=
# teste ou producao (padrão). Só muda o aviso no painel: o prefixo do token não diz o ambiente.
MP_MODO=

# --- Melhor Envio (sem token, a loja só vende com o frete fixo ligado em Configurações > Frete) ---
# Token pessoal (Configurações > Permissões de acesso > Tokens).
MELHOR_ENVIO_TOKEN=
# producao (padrão) ou sandbox
MELHOR_ENVIO_AMBIENTE=
# E-mail técnico enviado no User-Agent, exigido pelo Melhor Envio.
MELHOR_ENVIO_EMAIL=

# --- E-mails transacionais (opcional; sem chave os e-mails são pulados) ---
# Chave da API do Resend.
RESEND_API_KEY=
# Remetente, ex.: AMA <loja@seudominio.com.br> (domínio verificado no Resend).
EMAIL_REMETENTE=

# --- Tarefa agendada ---
# Protege /api/cron/manter-ativo. A Vercel envia "Authorization: Bearer <CRON_SECRET>" sozinha.
# Gere um valor aleatório longo (ex.: openssl rand -hex 32).
CRON_SECRET=

# --- Só para testes (servidores falsos); deixe vazio em produção ---
MP_API_BASE=
MELHOR_ENVIO_API_BASE=
RESEND_API_BASE=
