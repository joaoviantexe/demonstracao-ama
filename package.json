{
  "name": "ama-site",
  "private": true,
  "version": "1.0.0",
  "description": "Site, painel administrativo e loja da AMA — Associação de Mulheres na Amazônia",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:integracao": "node --test --test-concurrency=1 \"tests/integracao/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.js\""
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.116.0",
    "linkedom": "0.18.13",
    "playwright": "1.56.1",
    "wrangler": "4.145.0"
  }
}
